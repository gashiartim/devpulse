{
  "schemaVersion": 1,
  "id": "io.github.gashiartim.devpulse",
  "name": "DevPulse",
  "version": "0.2.0",
  "author": "Artim",
  "license": "MIT",
  "description": "Local dev servers, Git context, Docker ports, and resource usage in one keyboard-first dashboard.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "DevPulse",
    "description": "Discover and manage local development servers",
    "category": "Development",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showMetrics": true,
      "showGit": true,
      "warnExposed": true,
      "includeContainers": true,
      "includedPorts": "",
      "ignoredPorts": "",
      "refreshIntervalSec": 30,
      "activeIntervalSec": 3
    },
    "schema": [
      {
        "key": "showMetrics",
        "type": "boolean",
        "label": "Show CPU and memory",
        "defaultValue": true
      },
      {
        "key": "showGit",
        "type": "boolean",
        "label": "Show Git branch",
        "defaultValue": true
      },
      {
        "key": "warnExposed",
        "type": "boolean",
        "label": "Warn about LAN-exposed servers",
        "defaultValue": true
      },
      {
        "key": "includeContainers",
        "type": "boolean",
        "label": "Discover published Docker ports",
        "defaultValue": true
      },
      {
        "key": "includedPorts",
        "type": "string",
        "label": "Always include ports",
        "defaultValue": "",
        "description": "Comma-separated ports or ranges, for example 4100,9000-9005."
      },
      {
        "key": "ignoredPorts",
        "type": "string",
        "label": "Ignore ports",
        "defaultValue": "",
        "description": "Comma-separated ports or ranges. Ignoring takes precedence."
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Background refresh (seconds)",
        "min": 10,
        "max": 300,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "activeIntervalSec",
        "type": "integer",
        "label": "Open-panel refresh (seconds)",
        "min": 2,
        "max": 30,
        "step": 1,
        "defaultValue": 3
      }
    ]
  }
}
